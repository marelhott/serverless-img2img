{
  "title": "SDXL Img2Img Style Transfer",
  "description": "Minimal Diffusers-based SDXL img2img worker with one optional LoRA, designed for clean style transfer on RunPod Serverless.",
  "type": "serverless",
  "category": "image",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 40,
    "gpuCount": 1,
    "gpuIds": "ADA_24,AMPERE_48,ADA_48_PRO",
    "allowedCudaVersions": ["12.4", "12.5", "12.6", "12.7"],
    "env": [
      {
        "key": "MODEL_CONFIG_PATH",
        "input": {
          "name": "Model config path",
          "type": "string",
          "description": "Absolute path to the models.json file on the mounted RunPod volume.",
          "default": "/workspace/models/config/models.json"
        }
      },
      {
        "key": "DEFAULT_GUIDANCE_SCALE",
        "input": {
          "name": "Guidance scale",
          "type": "number",
          "description": "Internal CFG value used by the worker.",
          "min": 1,
          "max": 3,
          "default": 1.8,
          "step": 0.1
        },
        "advanced": true
      },
      {
        "key": "OUTPUT_FORMAT",
        "input": {
          "name": "Output format",
          "type": "select",
          "description": "Returned image encoding format.",
          "options": [
            { "label": "PNG", "value": "PNG" },
            { "label": "WebP", "value": "WEBP" }
          ],
          "default": "PNG"
        },
        "advanced": true
      },
      {
        "key": "MAX_IMAGE_SIDE",
        "input": {
          "name": "Max input side",
          "type": "number",
          "description": "Largest source dimension after normalization.",
          "min": 512,
          "max": 2048,
          "default": 1536
        },
        "advanced": true
      },
      {
        "key": "ENABLE_CPU_OFFLOAD",
        "input": {
          "type": "boolean",
          "name": "Enable CPU offload",
          "description": "Enable Diffusers CPU offload when VRAM is tight.",
          "default": false,
          "trueValue": "true",
          "falseValue": "false"
        },
        "advanced": true
      }
    ],
    "presets": [
      {
        "name": "Balanced SDXL",
        "defaults": {
          "MODEL_CONFIG_PATH": "/workspace/models/config/models.json",
          "DEFAULT_GUIDANCE_SCALE": 1.8,
          "OUTPUT_FORMAT": "PNG",
          "MAX_IMAGE_SIDE": 1536,
          "ENABLE_CPU_OFFLOAD": "false"
        }
      }
    ]
  }
}
